# =====================================================================
# MD-GCMC adsorption isotherm of pure CO2 in UiO-66
#
# The CO2 fugacities are computed beforehand with
# analysis/fugacity_mbwr.ipynb and passed to fix gcmc directly as the
# "pressure" argument (in atm, since units real), with fugacity_coeff 1.
# The inputs that depend on the system are collected in the USER INPUTS block.
# =====================================================================

# ----------------- USER INPUTS -----------------
# Replace each {...} below, or pass the value on the command line, e.g.,
#   lmp -var datafile my.data -in in.gcmc_CO2
variable datafile      index {datafile}   # data file to read (framework)
variable output_prefix index {output_prefix}   # prefix of the restart files written after each pressure
variable Tf            index {Tf}   # temperature (K), e.g., 303.15, 323.15, or 343.15
variable P_list        index {P_list}   # pressures (bar), space separated; used only to label the output files
variable f_list        index {f_list}   # fugacities (atm) at the pressures of P_list and T, from analysis/fugacity_mbwr.ipynb

units           real
atom_style      full
boundary        p p p
timestep        0.5                           # fs

# ----------------- 1) FORCE FIELD -----------------
# Framework: UFF with DDEC charges; guests: TraPPE (rigid)
pair_style      lj/cut/coul/long 12.5
bond_style      harmonic
angle_style     hybrid cosine/periodic fourier harmonic
dihedral_style  harmonic
improper_style  fourier
kspace_style    ewald 1.0e-4                  # Ewald summation, accuracy 1e-4

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
pair_modify     tail yes mix arithmetic       # Lorentz-Berthelot mixing for unlike pairs
special_bonds   lj/coul 0.0 0.0 1.0
dielectric      1.0

# ----------------- 2) STRUCTURE -----------------
# Relaxed UiO-66 cell (structures/data.UiO-66.ddec or your own relaxed
# cell); extra types are reserved for CO2.
read_data       ${datafile} &
                extra/atom/types 2 &
                extra/bond/types 1 &
                extra/angle/types 1 &
                extra/bond/per/atom 2 &
                extra/angle/per/atom 1 &
                extra/special/per/atom 2

group UiO type 1:5                            # framework atom types 1-5

# CO2 atom types: 6 = C, 7 = O
mass 6 12.0107
mass 7 15.9994
group CO2 type 6 7

molecule   co2 CO2.txt  toff 5  boff 7  aoff 14

pair_coeff 6 6 0.053649 2.80                  # C (TraPPE)
pair_coeff 7 7 0.156973 3.05                  # O (TraPPE)
bond_coeff 8 0 1.16                           # C-O, held rigid by fix rigid
angle_coeff 15 harmonic 0 180                 # O-C-O, held rigid by fix rigid

# ----------------- 3) RUNTIME -----------------
variable Tdamp        equal 100*dt

# MD-GCMC cadence (Sections 3.4 and 3.6 of the article)
variable GCMCNevery   equal 200               # MD steps between GCMC cycles
variable GCMCexchange equal 100               # insertion/deletion attempts per cycle
variable GCMCmove     equal 0                 # translation/rotation moves disabled
variable disp         equal 2.0
variable N_equil      equal 100000            # equilibration steps at each pressure
variable N_prod       equal 100000            # production steps at each pressure

fix   UiO_NVT UiO nvt temp ${Tf} ${Tf} ${Tdamp}                         # framework, NVT
fix   nvtCO2 CO2 rigid/nvt/small molecule temp ${Tf} ${Tf} ${Tdamp} mol co2  # rigid CO2
fix_modify nvtCO2 dynamic/dof yes

region regionGCMC block EDGE EDGE EDGE EDGE EDGE EDGE   # insertions in the whole cell

thermo          1000
thermo_style    custom step temp pe etotal press vol
compute_modify  thermo_temp dynamic/dof yes

# ----------------- 4) DIAGNOSTICS -----------------
variable  carbon atom "type==6"
variable  oxygen atom "type==7"
group     carbon dynamic CO2 var carbon
group     oxygen dynamic CO2 var oxygen
variable  nC     equal count(carbon)
variable  nO     equal count(oxygen)
variable  N      equal (v_nC+v_nO)/3          # number of adsorbed CO2 molecules
variable  N2     equal v_N*v_N                # N^2, for fluctuation formulas
variable  U      equal pe
variable  UN     equal v_U*v_N

# ----------------- 5) PRESSURE SWEEP -----------------
# P_list : pressures in bar (used only to label the output files)
# f_list : CO2 fugacity in atm at each pressure of P_list and at T = Tf,
#          from analysis/fugacity_mbwr.ipynb (same order and length)
variable phi    equal  1.0                    # fugacity already passed as pressure

label loopP
reset_timestep 0

variable P_bar equal ${P_list}
variable f_atm equal ${f_list}
print "=== GCMC: P = ${P_bar} bar, f(CO2) = ${f_atm} atm, T = ${Tf} K ==="

fix mygcmc CO2 gcmc ${GCMCNevery} ${GCMCexchange} ${GCMCmove} 0 1486221 &
    ${Tf} 0.0 ${disp} mol co2 group CO2 rigid nvtCO2 tfac_insert 1 full_energy &
    region regionGCMC pressure ${f_atm} fugacity_coeff ${phi}

variable ins_att  equal f_mygcmc[3]
variable ins_succ equal f_mygcmc[4]
variable del_att  equal f_mygcmc[5]
variable del_succ equal f_mygcmc[6]
thermo_style custom step temp pe etotal press vol &
             v_N v_ins_att v_ins_succ v_del_att v_del_succ

# equilibration
run_style verlet
run ${N_equil}

# production: step, P, N, N^2, U, U*N
variable s equal step
variable P equal ${P_bar}
fix RAW all ave/time 500 20 10000 &
    v_s v_P v_N v_N2 v_U v_UN &
    file raw_P=${P_bar}.txt ave one
run ${N_prod}

unfix RAW
unfix mygcmc
write_data ${output_prefix}_P=${P_bar}.data    # optional restart file

next f_list P_list
jump SELF loopP

print "=== Pressure sweep complete ==="
