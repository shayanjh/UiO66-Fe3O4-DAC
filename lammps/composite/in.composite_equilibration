# =====================================================================
# Equilibration of the Fe3O4/UiO-66/Fe3O4 composite
# (Section 3.2 of the article and Section S3 of the SI)
#
# The composite is assembled from the relaxed UiO-66 slab (H-capped at
# the cut faces) and two Fe3O4 slabs placed symmetrically below and
# above it. The inputs that depend on the system are collected in the
# USER INPUTS block.
# =====================================================================

# ----------------- USER INPUTS -----------------
# Replace each {...} below, or pass the value on the command line, e.g.,
#   lmp -var datafile my.data -in in.composite_equilibration
variable datafile      index {datafile}   # assembled composite (output of build_composite.py)
variable outfile       index {outfile}    # equilibrated composite
variable seed          index {seed}   # random seed

units           real
atom_style      full
boundary        p p f                      # nonperiodic in z
timestep        0.5                        # fs

pair_style      lj/cut/coul/long 12.5
pair_modify     mix arithmetic             # Lorentz-Berthelot
kspace_style    ewald 1.0e-4
kspace_modify   slab 3.0                   # Yeh-Berkowitz slab correction
special_bonds   lj/coul 0.0 0.0 0.5

bond_style      harmonic
angle_style     hybrid cosine/periodic fourier harmonic
dihedral_style  harmonic
improper_style  fourier

neighbor        3.0 bin
neigh_modify    delay 0 every 1 check yes

# Assembled composite; types are reserved for CO2 so that the equilibrated
# composite can be used directly in ../adsorption/in.gcmc_composite_CO2
read_data       ${datafile} &
                extra/atom/types 2 &
                extra/bond/types 1 &
                extra/angle/types 1 &
                extra/bond/per/atom 2 &
                extra/angle/per/atom 1 &
                extra/special/per/atom 2

# CO2 types (TraPPE, rigid); no CO2 is present during the equilibration
mass        9  12.0107                     # C (CO2)
mass        10 15.9994                     # O (CO2)
pair_coeff  9  9  0.053649 2.80
pair_coeff  10 10 0.156973 3.05
bond_coeff  8  0 1.16
angle_coeff 15 harmonic 0 180

include         ../cross_terms_Fe3O4_UiO66.lmp   # SI, Table S4 (atom types listed in the file)

group  mof  type 1 2 3 4 5
group  fe   type 6 7 8

fix    zwall all wall/lj93 zlo EDGE 0.02 2.5 3.0 zhi EDGE 0.02 2.5 3.0 units box

compute T_mof mof temp
compute T_fe  fe  temp
thermo_style custom step time temp c_T_mof c_T_fe pe etotal
thermo       500

# Stage 1: energy minimization
minimize   1.0e-4 1.0e-6 10000 50000

# Stage 2: gentle start
velocity   all create 50.0 ${seed} mom yes rot no dist gaussian
fix        pre all nve/limit 0.01
run        5000
unfix      pre

# Stage 3: heating to 303 K
fix        nvt_mof mof nvt temp 50.0 303.0 50.0
fix        nvt_fe  fe  nvt temp 50.0 303.0 50.0
run        50000
unfix      nvt_mof
unfix      nvt_fe

# Stage 4: equilibration at 303 K
fix        nvt_mof mof nvt temp 303.0 303.0 50.0
fix        nvt_fe  fe  nvt temp 303.0 303.0 50.0
run        150000

write_data ${outfile}
