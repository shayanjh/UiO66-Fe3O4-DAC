# =====================================================================
# MD-GCMC coadsorption of CO2 and H2O in UiO-66
#
# Following Section 3.4 of the article, the framework is first
# equilibrated with water alone at the partial pressure RH x Psat(T)
# (2 x 10^6 MD steps; this run is not part of this file). The resulting
# configuration is read below, CO2 is introduced, and both species are
# exchanged: H2O at a fixed partial pressure and CO2 at the fugacities
# of f_list. The inputs that depend on the system are collected in the
# USER INPUTS block.
#
# RH may also be passed from the command line:
#   lmp -var RH_val 0.4 -in in.gcmc_CO2_H2O
# =====================================================================

# ----------------- USER INPUTS -----------------
# Replace each {...} below, or pass the value on the command line, e.g.,
#   lmp -var datafile my.data -in in.gcmc_CO2_H2O
variable datafile      index {datafile}   # data file to read (framework with water at RH)
variable output_prefix index {output_prefix}   # prefix of the restart files written after each pressure
variable Tf            index {Tf}   # temperature (K), e.g., 303.15, 323.15, or 343.15
variable RH_val        index {RH_val}   # relative humidity (0 to 1)
variable Psat_H2O      index {Psat_H2O}   # saturation pressure of water at Tf (atm)
variable P_list        index {P_list}   # pressures (bar), space separated; used only to label the output files
variable f_list        index {f_list}   # fugacities (atm) at the pressures of P_list and T, from analysis/fugacity_mbwr.ipynb

units           real
atom_style      full
boundary        p p p
timestep        0.5                           # fs

# ----------------- 1) FORCE FIELD -----------------
# Framework: UFF with DDEC charges; CO2: TraPPE (rigid); H2O: SPC/E (rigid)
pair_style      lj/cut/coul/long 12.5
bond_style      harmonic
angle_style     hybrid cosine/periodic fourier harmonic
dihedral_style  harmonic
improper_style  fourier
kspace_style    ewald 1.0e-4                  # Ewald summation, accuracy 1e-4

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
pair_modify     tail yes mix arithmetic       # Lorentz-Berthelot mixing for unlike pairs
special_bonds   lj/coul 0.0 0.0 1.0
dielectric      1.0

# ----------------- 2) STRUCTURE -----------------
# Framework preequilibrated with water at the chosen RH; the data file
# must contain H2O types (6 = O, 7 = H) and the extra types for CO2.
read_data       ${datafile}

group UiO type 1:5                            # framework atom types 1-5
group H2O type 6 7                            # SPC/E water: 6 = O, 7 = H

# CO2 atom types: 8 = C, 9 = O
mass 8 12.0107
mass 9 15.9994
group CO2 type 8 9

pair_coeff 8 8 0.053649 2.80                  # C (CO2, TraPPE)
pair_coeff 9 9 0.156973 3.05                  # O (CO2, TraPPE)
bond_coeff 9 0 1.16                           # C-O, held rigid by fix rigid
angle_coeff 16 harmonic 0 180                 # O-C-O, held rigid by fix rigid

molecule h2o H2O.txt toff 5 boff 7 aoff 14
molecule co2 CO2.txt toff 7 boff 8 aoff 15

# ----------------- 3) RUNTIME -----------------
variable Tdamp        equal 100*dt

# MD-GCMC cadence (Sections 3.4 and 3.6 of the article)
variable GCMCNevery   equal 200               # MD steps between GCMC cycles
variable GCMCexchange equal 100               # insertion/deletion attempts per cycle
variable GCMCmove     equal 0                 # translation/rotation moves disabled
variable disp         equal 2.0
variable N_equil      equal 100000            # equilibration steps at each pressure
variable N_prod       equal 100000            # production steps at each pressure


fix   UiO_NVT UiO nvt temp ${Tf} ${Tf} ${Tdamp}
fix   nvtCO2 CO2 rigid/nvt/small molecule temp ${Tf} ${Tf} ${Tdamp} mol co2
fix_modify nvtCO2 dynamic/dof yes
fix   nvtH2O H2O rigid/nvt/small molecule temp ${Tf} ${Tf} ${Tdamp} mol h2o
fix_modify nvtH2O dynamic/dof yes

region regionGCMC block EDGE EDGE EDGE EDGE EDGE EDGE

thermo          1000
thermo_style    custom step temp pe etotal press vol
compute_modify  thermo_temp dynamic/dof yes

# ----------------- 4) DIAGNOSTICS -----------------
variable  carbon   atom "type==8"
variable  oxygen   atom "type==9"
group     carbon   dynamic CO2 var carbon
group     oxygen   dynamic CO2 var oxygen
variable  nC       equal count(carbon)
variable  nO       equal count(oxygen)
variable  NC       equal (v_nC+v_nO)/3        # adsorbed CO2 molecules

variable  hydrogen atom "type==7"
variable  oxygenW  atom "type==6"
group     hydrogen dynamic H2O var hydrogen
group     oxygenW  dynamic H2O var oxygenW
variable  nH       equal count(hydrogen)
variable  nOW      equal count(oxygenW)
variable  NH       equal (v_nH+v_nOW)/3       # adsorbed H2O molecules

variable  N        equal v_NH+v_NC            # total adsorbed molecules
variable  N2       equal v_N*v_N              # N^2, for fluctuation formulas
variable  U        equal pe
variable  UN       equal v_U*v_N

# ----------------- 5) WATER PARTIAL PRESSURE -----------------
# P_H2O = RH x Psat(T), constant during the CO2 sweep; Psat(T) in atm at
# T = Tf from the Antoine equation. At these low pressures the fugacity
# coefficient of water is taken as 1.
variable Ph2o_fixed equal ${RH_val}*${Psat_H2O}
print ">>> RH = ${RH_val} | P_H2O = ${Ph2o_fixed} atm"

# ----------------- 6) CO2 PRESSURE SWEEP -----------------
# P_list : CO2 pressures in bar (used only to label the output files)
# f_list : CO2 fugacity in atm at each pressure of P_list and at T = Tf,
#          from analysis/fugacity_mbwr.ipynb (same order and length)

label loopP
reset_timestep 0

variable P_bar equal ${P_list}
variable f_CO2 equal ${f_list}
print "=== CO2: P = ${P_bar} bar, f = ${f_CO2} atm | H2O: RH = ${RH_val}, P = ${Ph2o_fixed} atm ==="

fix hgcmc H2O gcmc ${GCMCNevery} ${GCMCexchange} ${GCMCmove} 0 3487621 &
    ${Tf} 0.0 ${disp} mol h2o group H2O rigid nvtH2O tfac_insert 1 full_energy &
    region regionGCMC pressure ${Ph2o_fixed} fugacity_coeff 1.0

fix cgcmc CO2 gcmc ${GCMCNevery} ${GCMCexchange} ${GCMCmove} 0 1486221 &
    ${Tf} 0.0 ${disp} mol co2 group CO2 rigid nvtCO2 tfac_insert 1 full_energy &
    region regionGCMC pressure ${f_CO2} fugacity_coeff 1.0

variable ins_catt  equal f_cgcmc[3]
variable ins_csucc equal f_cgcmc[4]
variable del_catt  equal f_cgcmc[5]
variable del_csucc equal f_cgcmc[6]
variable ins_hatt  equal f_hgcmc[3]
variable ins_hsucc equal f_hgcmc[4]
variable del_hatt  equal f_hgcmc[5]
variable del_hsucc equal f_hgcmc[6]
thermo_style custom step temp pe etotal press vol v_NH v_NC v_N &
             v_ins_catt v_ins_csucc v_del_catt v_del_csucc &
             v_ins_hatt v_ins_hsucc v_del_hatt v_del_hsucc

# equilibration
run_style verlet
run ${N_equil}

# production: step, P, N(H2O), N(CO2), N, N^2, U, U*N
variable s equal step
variable P equal ${P_bar}
fix RAW all ave/time 500 20 10000 &
    v_s v_P v_NH v_NC v_N v_N2 v_U v_UN &
    file raw_P=${P_bar}.txt ave one
run ${N_prod}

unfix RAW
unfix hgcmc
unfix cgcmc
write_data ${output_prefix}_RH=${RH_val}_P=${P_bar}.data   # optional restart file

next P_list f_list
jump SELF loopP

print "=== Sweep complete, RH = ${RH_val} ==="
